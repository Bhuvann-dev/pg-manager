rules_version = '2';

// PG Manager — Firebase Storage security rules.
//
// Tenant ID documents (Aadhaar) are private PII under an owner-scoped path,
// readable/writable only by the owning account. Uploads are additionally
// capped to 5 MB and restricted to images or PDFs, so an authenticated
// account can't abuse storage with huge or arbitrary files.

service firebase.storage {
  match /b/{bucket}/o {

    // owners/{ownerUid}/tenants/{tenantId}/{file}
    match /owners/{ownerUid}/{allPaths=**} {
      function isOwner() {
        return request.auth != null && request.auth.uid == ownerUid;
      }

      allow read: if isOwner();

      allow write: if isOwner()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');

      allow delete: if isOwner();
    }

    // Everything else is denied by default.
  }
}
